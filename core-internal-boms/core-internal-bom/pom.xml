<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.netcracker.cloud</groupId>
    <artifactId>core-internal-bom</artifactId>
    <version>1.1.1</version>
    <packaging>pom</packaging>

    <description>Internal BOM for pure-Java modules: common 3rd-party dependency versions for use inside the monorepo</description>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/Netcracker/qubership-core-java-libs.git</connection>
        <developerConnection>scm:git:https://github.com/Netcracker/qubership-core-java-libs.git</developerConnection>
        <url>https://github.com/Netcracker/qubership-core-java-libs</url>
        <tag>core-internal-boms-1.1.1</tag>
    </scm>

    <properties>
        <!--
        Cross-stack pins below carry a note with the version each platform manages, so the next Spring Boot or Quarkus
        upgrade shows whether the pin still buys anything. Drop a pin once both platforms agree on the version.
        -->

        <!-- Logging -->
        <slf4j.version>2.0.18</slf4j.version>
        <logback.version>1.5.34</logback.version>
        <log4j.version>2.26.1</log4j.version>
        <!-- Spring Boot 4.1.0: 3.6.3.Final | Quarkus 3.33.3.1: 3.6.2.Final -->
        <jboss-logging.version>3.6.3.Final</jboss-logging.version>

        <!-- Build / annotation processing -->
        <lombok.version>1.18.46</lombok.version>
        <jandex.version>3.5.3</jandex.version>

        <!-- Jackson -->
        <jackson-bom.version>2.21.5</jackson-bom.version>

        <!-- Metrics -->
        <micrometer-bom.version>1.16.6</micrometer-bom.version>

        <!-- Annotations -->
        <jetbrains-annotations.version>26.0.2</jetbrains-annotations.version>

        <!-- HTTP clients -->
        <okhttp3.version>4.12.0</okhttp3.version>
        <okio.version>3.18.1</okio.version>

        <!-- JSON / YAML / protobuf -->
        <gson.version>2.13.2</gson.version>
        <jsonpath.version>2.10.0</jsonpath.version>
        <!-- Spring Boot 4.1.0: 2.6 | Quarkus 3.33.3.1: 2.5 -->
        <snakeyaml.version>2.6</snakeyaml.version>
        <!-- Spring Boot 4.1.0: 4.34.2 | Quarkus 3.33.3.1: 4.33.2 -->
        <protobuf.version>4.34.2</protobuf.version>
        <!-- Spring Boot 4.1.0: 1.80.0 | Quarkus 3.33.3.1: 1.81.0. gRPC and protobuf move together. -->
        <grpc-bom.version>1.81.0</grpc-bom.version>

        <!-- Jakarta EE APIs -->
        <!-- This block explicitly pins Jakarta EE API versions to override the ones brought in by the
             Spring and Quarkus BOMs, keeping them aligned across both platforms inside the monorepo. -->
        <jakarta.ws.rs-api.version>4.0.0</jakarta.ws.rs-api.version>
        <jakarta.validation-api.version>3.1.1</jakarta.validation-api.version>
        <jakarta.annotation-api.version>3.0.0</jakarta.annotation-api.version>
        <hibernate-validator.version>9.1.0.Final</hibernate-validator.version>
        <!-- Spring Boot 4.1.0: 3.0.2 | Quarkus 3.33.3.1: 3.0.1 -->
        <jakarta.json.bind-api.version>3.0.2</jakarta.json.bind-api.version>
        <!-- Spring Boot 4.1.0: 4.0.9 | Quarkus 3.33.3.1: 4.0.8 -->
        <jaxb.version>4.0.9</jaxb.version>
        <!-- Spring Boot 4.1.0: 1.7.3 | Quarkus 3.33.3.1: 1.7.1. Reflection helper behind hibernate-validator. -->
        <classmate.version>1.7.3</classmate.version>

        <!-- Apache Commons -->
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <commons-io.version>2.21.0</commons-io.version>
        <commons-collections4.version>4.6.0</commons-collections4.version>

        <!-- HTTP clients (Apache) -->
        <apache.httpclient5.version>5.6.3</apache.httpclient5.version>

        <!-- Databases -->
        <!-- Spring Boot 4.1.0: 5.8.0 | Quarkus 3.33.3.1: 5.6.4 -->
        <mongodb-driver-bom.version>5.8.0</mongodb-driver-bom.version>
        <!-- Spring Boot 4.1.0: 42.7.11 | Quarkus 3.33.3.1: 42.7.13. Quarkus leads here, so the pin moves the JDBC
             driver up on the Spring side. -->
        <postgresql.version>42.7.13</postgresql.version>

        <!-- Database migration -->
        <!-- Spring Boot 4.1.0: 12.4.0 | Quarkus 3.33.3.1: 12.0.0 -->
        <flyway.version>12.4.0</flyway.version>

        <!-- Other compile/runtime -->
        <guava.version>33.5.0-jre</guava.version>
        <rxjava.version>2.2.21</rxjava.version>
        <hikaricp.version>7.0.2</hikaricp.version>
        <undertow.version>2.3.26.Final</undertow.version>
        <reflections.version>0.10.2</reflections.version>
        <awaitility.version>4.3.0</awaitility.version>
        <!-- Spring Boot 4.1.0: 3.2.4 | Quarkus 3.33.3.1: 3.2.3 -->
        <caffeine.version>3.2.4</caffeine.version>
        <!-- Spring Boot 4.1.0: 2.3.21 | Quarkus 3.33.3.1: 2.3.10 -->
        <kotlin-bom.version>2.3.21</kotlin-bom.version>

        <!-- Messaging -->
        <rabbitmq.version>5.33.1</rabbitmq.version>
        <rabbitmq-mock.version>1.2.0</rabbitmq-mock.version>
        <!-- Spring Boot 4.1.0: 4.2.1 | Quarkus 3.33.3.1: 4.1.2. Follows Spring, unlike the pins above:
             spring-kafka-test 4.1.0 calls ConfigDef$ValidList.anyNonDuplicateValues, added in Kafka 4.2.x, so
             @EmbeddedKafka fails to start the broker on 4.1.2. This raises the Quarkus side to 4.2.1. -->
        <kafka.version>4.2.1</kafka.version>

        <!-- Test -->
        <junit-bom.version>6.0.3</junit-bom.version>
        <mockito.version>5.23.0</mockito.version>
        <!-- Spring Boot 4.1.0: 1.18.10 | Quarkus 3.33.3.1: 1.17.8. Kept on the branch Mockito 5.21.0 was built
             against; revisit together with mockito.version. -->
        <byte-buddy.version>1.18.10</byte-buddy.version>
        <!-- Spring Boot 4.1.0: 3.0 | Quarkus 3.33.3.1: 2.2. REST Assured on the Quarkus side needs 2.x. -->
        <hamcrest.version>2.2</hamcrest.version>
        <assertj.version>3.27.7</assertj.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <system-stubs.version>2.1.8</system-stubs.version>
        <junit-pioneer.version>2.3.0</junit-pioneer.version>
        <h2.version>2.4.240</h2.version>
        <logcaptor.version>2.12.6</logcaptor.version>
        <mockserver.version>7.6.0</mockserver.version>
        <mongo-java-server.version>1.47.0</mongo-java-server.version>
        <docker-java.version>3.7.1</docker-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- ===== BOM imports ===== -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
            Pinned to the version Quarkus 3.33.3.1 ships, so both stacks build against the same Micrometer. Spring Boot
            4.1.0 would otherwise raise the Spring side to 1.17.0, which also drops the transitive LatencyUtils
            dependency that AbstractTimer still declares a field for, breaking Mockito spies on Timer. This import is
            declared before the Spring Boot and Quarkus BOMs, so it wins for both stacks. Remove the pin once Quarkus
            ships the Micrometer version that Spring Boot manages.
            -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-bom</artifactId>
                <version>${micrometer-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
            The MongoDB driver, gRPC and the Kotlin standard library are pinned for the same reason as Micrometer
            above: shared pure-Java modules compile against whatever this BOM manages, and the Quarkus runtime then
            supplies its own version. See the version properties for what each platform ships.

            OpenTelemetry is deliberately absent. No pure-Java module depends on it, and Spring Boot has to keep
            deciding the core version: the instrumentation BOMs imported by maas-declarative-client-spring are built
            against the core version Spring Boot manages, and a mismatch fails at context startup, not at compile time.
            -->
            <dependency>
                <groupId>org.mongodb</groupId>
                <artifactId>mongodb-driver-bom</artifactId>
                <version>${mongodb-driver-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-bom</artifactId>
                <version>${kotlin-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

